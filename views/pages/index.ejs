<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { title }) %>
  <body>
    <h1><%= title %></h1>

    <p><a href="/new">Add a new message</a></p>

    <ul>
      <% messages.forEach((message, index) => { %>
        <li>
          <p><%= message.user %></p>
          <p><%= message.text %></p>
          <p><%= message.added.toLocaleString() %></p>
          <p><a href="/messages/<%= index %>">Open</a></p>
          <hr />
        </li>
      <% }) %>
    </ul>
  </body>
</html>
