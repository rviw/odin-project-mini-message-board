<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { title }) %>
  <body>
    <h1><%= title %></h1>

    <p>Author: <%= message.user %></p>
    <p>Message: <%= message.text %></p>
    <p>Added: <%= message.added.toLocaleString() %></p>

    <p><a href="/">Back to all messages</a></p>
  </body>
</html>
