<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { title }) %>
  <body>
    <a href="/">Back to all messages</a>

    <h1><%= title %></h1>

    <p>Author: <%= message.user %></p>
    <p>Message: <%= message.text %></p>
    <p>Added: <%= message.added.toLocaleString() %></p>

    <form action="/messages/<%= message.id %>/delete" method="post">
      <button type="submit" onclick="return confirm('Are you sure you want to delete this message?')">Delete</button>
    </form>
  </body>
</html>
